{
  "$schema": "https://opencode.ai/config.json",
  "model": "cliproxy/gpt-6-luna",
  "instructions": [
    "enpire/policy/autoresearch_instruction.md",
    "enpire/env/examples/20_simulated_pusht/README.md",
    "autoresearch_runs/pusht/EXPERIMENT_PROTOCOL.md",
    "autoresearch_runs/pusht/TIMING_LOGGING.md"
  ],
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "{env:API_URL}",
        "apiKey": "{env:API_KEY_2}"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "options": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  }
}
